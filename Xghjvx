-- ═══════════ DETECTION (Xeno-safe) ═══════════
local function isNPC(obj)
    if not obj:IsA("Model") then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function isEnemy(obj)
    local n = string.lower(obj.Name)
    local pn = obj.Parent and string.lower(obj.Parent.Name) or ""
    if pn:find("enem") or pn:find("mob") or pn:find("boss") or pn:find("pirate") then return true end
    local keywords = {"bandit","pirate","marine","soldier","brigade","rebel","boss","captain",
                     "thug","criminal","military","sword","jester","clown","monkey","fisherman",
                     "raider","merc","elite","guard","brute","villain","demonic","sky","vice"}
    for _, kw in ipairs(keywords) do
        if n:find(kw) then return true end
    end
    return false
end

local highlights = {}
local function toggleESP(on)
    for _,hl in pairs(highlights) do hl:Destroy() end
    highlights = {}
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isNPC(obj) then
                local hl = Instance.new("Highlight", obj)
                hl.FillColor = isEnemy(obj) and C.enemy or C.npc
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.new(1,1,1)
                highlights[obj] = hl
            end
        end
    end
end

-- ═══════════ LIST ═══════════
local filterEnemies = false
local function refreshList()
    for _,ch in ipairs(scroll:GetChildren()) do
        if ch:IsA("TextButton") or ch:IsA("Frame") then ch:Destroy() end
    end
    local npcs = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) and (not filterEnemies or isEnemy(obj)) then
            table.insert(npcs, obj)
        end
    end
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    table.sort(npcs, function(a, b)
        if not myHRP then return false end
        local aH = a:FindFirstChild("HumanoidRootPart")
        local bH = b:FindFirstChild("HumanoidRootPart")
        if not aH or not bH then return false end
        return (aH.Position - myHRP.Position).Magnitude < (bH.Position - myHRP.Position).Magnitude
    end)
    status.Text = ("Found %d NPC"):format(#npcs)
    for i, npc in ipairs(npcs) do
        local hum = npc:FindFirstChildOfClass("Humanoid")
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        local dist = (hrp and myHRP) and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1,0,0,36)
        row.BackgroundColor3 = C.bg3; row.BackgroundTransparency = 0.4
        row.Text = ""; row.LayoutOrder = i; row.Parent = scroll
        corner(row,6)
        local strip = Instance.new("Frame")
        strip.Size = UDim2.new(0,3,1,-6); strip.Position = UDim2.new(0,3,0,3)
        strip.BackgroundColor3 = isEnemy(npc) and C.enemy or C.npc
        strip.Parent = row; corner(strip,2)
        local nameL = Instance.new("TextLabel")
        nameL.Size = UDim2.new(1,-110,0,14); nameL.Position = UDim2.new(0,12,0,4)
        nameL.BackgroundTransparency = 1; nameL.TextColor3 = C.text
        nameL.Font = Enum.Font.GothamBold; nameL.TextSize = 10
        nameL.TextXAlignment = Enum.TextXAlignment.Left
        nameL.Text = npc.Name; nameL.Parent = row
        local infoL = Instance.new("TextLabel")
        infoL.Size = UDim2.new(1,-110,0,12); infoL.Position = UDim2.new(0,12,0,18)
        infoL.BackgroundTransparency = 1; infoL.TextColor3 = C.text2
        infoL.Font = Enum.Font.Gotham; infoL.TextSize = 9
        infoL.TextXAlignment = Enum.TextXAlignment.Left
        infoL.Text = ("HP: %d | %dm"):format(math.floor(hum.Health), dist)
        infoL.Parent = row
        local tpB = Instance.new("TextButton")
        tpB.Size = UDim2.new(0,44,0,26); tpB.Position = UDim2.new(1,-96,0.5,-13)
        tpB.BackgroundColor3 = C.accent; tpB.TextColor3 = Color3.new(1,1,1)
        tpB.Text = "TP"; tpB.Font = Enum.Font.GothamBold
        tpB.TextSize = 10; tpB.Parent = row; corner(tpB,5)
        tpB.MouseButton1Click:Connect(function()
            local chr = LP.Character
            local myR = chr and chr:FindFirstChild("HumanoidRootPart")
            local tR = npc:FindFirstChild("HumanoidRootPart")
            if myR and tR then myR.CFrame = tR.CFrame + Vector3.new(0,3,3) end
        end)
        local farmB = Instance.new("TextButton")
        farmB.Size = UDim2.new(0,44,0,26); farmB.Position = UDim2.new(1,-48,0.5,-13)
        farmB.BackgroundColor3 = C.err; farmB.TextColor3 = Color3.new(1,1,1)
        farmB.Text = "Farm"; farmB.Font = Enum.Font.GothamBold
        farmB.TextSize = 10; farmB.Parent = row; corner(farmB,5)
        farmB.MouseButton1Click:Connect(function()
            getgenv()._targetNPC = npc
            getgenv()._autoFarm = true
            autoBtn.Text = "Auto: ON"; autoBtn.BackgroundColor3 = C.ok
        end)
    end
end

-- ═══════════ AUTO ATTACK (Xeno-safe) ═══════════
local autoAtk = false
RunService.Heartbeat:Connect(function()
    if not autoAtk then return end
    local target = getgenv()._targetNPC
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not target or not target.Parent then
        if not myHRP then return end
        local nearest, nd = nil, 9999
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isNPC(obj) and isEnemy(obj) then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - myHRP.Position).Magnitude
                    if d < nd then nearest, nd = obj, d end
                end
            end
        end
        getgenv()._targetNPC = nearest
        target = nearest
    end
    if target and target.Parent and myHRP then
        local hum = target:FindFirstChildOfClass("Humanoid")
        local tR = target:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and tR then
            myHRP.CFrame = CFrame.new(myHRP.Position, Vector3.new(tR.Position.X, myHRP.Position.Y, tR.Position.Z))
            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        else
            getgenv()._targetNPC = nil
        end
    end
end)

